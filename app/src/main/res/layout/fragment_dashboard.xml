<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTotalExpenses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wydatki: 0.00 zł"
            android:textSize="18sp"
            android:textColor="@color/gray_800" />

        <TextView
            android:id="@+id/tvNetBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo netto: 0.00 zł"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvInsights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analiza miesięczna"
            android:layout_marginTop="12dp"
            android:textColor="@color/gray_600" />

        <TextView
            android:id="@+id/tvBudgetWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ Przekroczono budżet"
            android:textColor="@color/red_900"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieChart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvNoData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Brak danych do wykresu"
            android:gravity="center"
            android:visibility="gone"
            android:textColor="@color/gray_600"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
